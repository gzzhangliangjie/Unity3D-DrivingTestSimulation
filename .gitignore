# 直角转弯调参工具：只入库跑批脚本与定版配置，其余运行产物（结果/标记/场景dump）不入库
/Tuning/*
!/Tuning/tune_zjzw.py
!/Tuning/zjzw_tuning.json

# 构建产物
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Unity 崩溃报告
sysinfo.txt
